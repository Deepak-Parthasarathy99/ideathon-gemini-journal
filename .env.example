# Copy to .env for local runs. Never commit .env.
# On Cloud Run these come from --set-env-vars and Secret Manager.

GOOGLE_CLOUD_PROJECT=your-project-id
FIREBASE_PROJECT_ID=your-project-id

# Gemini via AI Studio (what the Ideathon rules ask for).
# Locally: paste the key. On Cloud Run: inject from Secret Manager.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

MODEL=gemini-3.6-flash

# Requests per user per minute.
RATE_LIMIT_PER_MINUTE=20

# Firebase web config (public — safe in the browser).
# Firebase console > Project settings > Your apps > Web app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_APP_ID=
