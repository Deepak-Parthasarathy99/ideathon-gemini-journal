rules_version = '2';

// Deny by default. A user may only ever touch documents under their own uid.
//
// Note: this server reads and writes with the Admin SDK, which bypasses these
// rules entirely. They are the second lock, not the only one — they matter if
// anything ever talks to Firestore straight from the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /entries/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /thread/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /insights/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
