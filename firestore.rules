rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The authenticated backend owns writes, validates schemas and maintains
    // transaction/limiter state. Admin SDK operations bypass these rules.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /entries/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
        match /thread/{messageId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }
      }
      match /insights/{day} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
